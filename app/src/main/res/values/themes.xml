<resources>

    <!-- Only the launch window uses this; all UI is Compose (see EuroklicTheme). -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!--
      Splash (androidx.core.splashscreen). Before this, the activity had no splash theme, so
      Android 12+ fell back to its own heuristic — a plain light-gray window with the launcher
      icon, unrelated to the brand palette. Background = splash_background (colors.xml) — see
      that file for why it's a separately-named token rather than BrandBlue/brandButton. Icon
      reuses the same mark as the launcher (ic_launcher_foreground) — no separate asset needed.
    -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
